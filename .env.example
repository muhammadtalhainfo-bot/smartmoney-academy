# ICT Flow environment template
# Copy this file to .env.local for local development.
# Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Market data (optional; ticker route returns no fake prices when unset)
FINNHUB_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE=
NEXT_PUBLIC_STRIPE_YEARLY_PRICE=
NEXT_PUBLIC_APP_URL=https://ictflow.com

# OneSignal server API
ONESIGNAL_REST_API_KEY=

# Anthropic AI Coach (server-only)
ANTHROPIC_API_KEY=

# AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Admin
ADMIN_PASSWORD=
