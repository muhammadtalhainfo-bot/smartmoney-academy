<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 300" width="500" height="300">
  <rect width="500" height="300" fill="#080808"/>
  <rect width="500" height="300" fill="url(#grad)" opacity="0.4"/>
  <defs>
    <radialGradient id="grad" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="#D4A843" stop-opacity="0.08"/>
      <stop offset="100%" stop-color="#080808" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <!-- Grid lines -->
  <line x1="0" y1="60" x2="500" y2="60" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <line x1="0" y1="120" x2="500" y2="120" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <line x1="0" y1="180" x2="500" y2="180" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <line x1="0" y1="240" x2="500" y2="240" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <line x1="100" y1="0" x2="100" y2="300" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <line x1="200" y1="0" x2="200" y2="300" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <line x1="300" y1="0" x2="300" y2="300" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <line x1="400" y1="0" x2="400" y2="300" stroke="#D4A843" stroke-width="0.3" opacity="0.08"/>
  <!-- Border -->
  <rect x="1" y="1" width="498" height="298" fill="none" stroke="#D4A843" stroke-width="0.5" opacity="0.15" rx="2"/>
  <!-- Module number badge -->
  <rect x="20" y="20" width="50" height="22" fill="rgba(212,168,67,0.12)" stroke="#D4A843" stroke-width="0.8" rx="3"/>
  <text x="45" y="35" text-anchor="middle" font-size="10" font-family="monospace" fill="#D4A843" font-weight="bold" letter-spacing="1">MOD 20</text>
  <!-- NEW badge -->
  <rect x="78" y="20" width="36" height="22" fill="rgba(52,211,153,0.12)" stroke="#34D399" stroke-width="0.8" rx="3"/>
  <text x="96" y="35" text-anchor="middle" font-size="10" font-family="monospace" fill="#34D399" font-weight="bold">NEW</text>
  <!-- Chart visual area -->
  <g transform="translate(0, 20)"><line x1="100" y1="160" x2="180" y2="120" stroke="#D4A843" stroke-width="2" opacity="0.5"/><line x1="180" y1="120" x2="260" y2="140" stroke="#D4A843" stroke-width="1.5" opacity="0.4" stroke-dasharray="4,4"/><line x1="260" y1="140" x2="340" y2="90" stroke="#D4A843" stroke-width="2.5" opacity="0.8"/><circle cx="340" cy="90" r="6" fill="#D4A843"/><text x="350" y="87" font-size="10" fill="#D4A843" opacity="0.7" font-family="monospace">DOL</text></g>
  <!-- Bottom text area -->
  <rect x="0" y="220" width="500" height="80" fill="rgba(8,8,8,0.9)"/>
  <line x1="20" y1="222" x2="480" y2="222" stroke="#D4A843" stroke-width="0.5" opacity="0.3"/>
  <!-- Emoji -->
  <text x="28" y="252" font-size="22" font-family="serif">📖</text>
  <!-- Title -->
  <text x="60" y="248" font-size="15" font-family="Arial Black, sans-serif" fill="white" font-weight="bold" letter-spacing="-0.3">Narrative Building</text>
  <!-- Subtitle -->
  <text x="60" y="268" font-size="11" font-family="monospace" fill="#D4A843" opacity="0.7" letter-spacing="0.5">ICT · ADVANCED · 8 LESSONS</text>
  <!-- ICT Flow branding -->
  <text x="480" y="292" text-anchor="end" font-size="9" font-family="monospace" fill="#D4A843" opacity="0.3" letter-spacing="1">ICTFLOW.COM</text>
</svg>